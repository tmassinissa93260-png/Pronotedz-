# Copier ce fichier en « .env » et remplir les clés.
# Le .env ne doit JAMAIS être mis sur GitHub.

# ── Obligatoire ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
FAL_KEY=...
ELEVENLABS_API_KEY=...

# ── Optionnel ────────────────────────────────────────────────
GROQ_API_KEY=              # transcription, pour l'analyse de vidéos
PERPLEXITY_API_KEY=        # recherche web avant d'écrire le script

# ── Garde-fous de budget (en euros) ──────────────────────────
BUDGET_MENSUEL_EUR=80
BUDGET_MAX_PAR_VIDEO_EUR=0.60
BUDGET_MAX_PAR_ANALYSE_EUR=0.25

# ── Réglages ─────────────────────────────────────────────────
PROFIL=equilibre           # economique | equilibre | premium
DUREE_CIBLE_S=90
LANGUE=fr
WEB_PORT=7777
