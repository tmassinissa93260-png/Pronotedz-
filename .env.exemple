# ═══════════════════════════════════════════════════════════════════
#  Copie ce fichier en « .env » et colle tes clés après le signe =
#
#  ⚠️ JAMAIS de commentaire sur la même ligne qu'une valeur :
#     il serait lu comme faisant partie de la clé.
#     Les commentaires vont toujours sur leur propre ligne.
#
#  ⚠️ Ni espace, ni guillemets autour de la clé.
#     Bon   : ANTHROPIC_API_KEY=sk-ant-abc123
#     Mauvais : ANTHROPIC_API_KEY = "sk-ant-abc123"
#
#  Le fichier .env ne doit JAMAIS être mis sur GitHub.
# ═══════════════════════════════════════════════════════════════════

# ── Les scripts ─────────────────────────────────────────────────────
# console.anthropic.com → API Keys   (≠ claude.ai, il faut du crédit)
ANTHROPIC_API_KEY=

# ── Les images et l'animation ───────────────────────────────────────
# fal.ai/dashboard/keys   (facultatif avec --profil gratuit : voir GROQ_API_KEY)
FAL_KEY=

# ── La voix ─────────────────────────────────────────────────────────
# elevenlabs.io → avatar → API Keys   (formule gratuite disponible)
ELEVENLABS_API_KEY=

# ── La transcription, et TOUT le reste SANS crédit Anthropic ────────
# console.groq.com → API Keys   (gratuit, sans carte bancaire)
# Sert `--profil gratuit`, qui écrit avec Llama à la place de Claude et
# illustre avec Pollinations (aucune clé) à la place de fal.ai. Couvre aussi
# la VISION (`charte`, lire le style d'une vidéo) via un second modèle Groq,
# choisi automatiquement. Ce profil ne demande donc ni ANTHROPIC_API_KEY ni
# FAL_KEY — seulement celle-ci.
GROQ_API_KEY=

# ── La recherche web avant écriture (optionnel) ─────────────────────
PERPLEXITY_API_KEY=

# ── Reconnaissance de musique (optionnel) ───────────────────────────
# audd.io → Sign up   (300 identifications gratuites, sans carte)
# Sans cette clé, `pdz musique` mesure quand même tempo, tonalité et
# énergie : il ne donne simplement pas le titre du morceau.
AUDD_API_KEY=

# ── Animation, alternative à fal.ai (optionnel) ─────────────────────
# ⚠️ L'adresse exacte de leur API n'a pas pu être vérifiée : à confirmer
#    dans leur documentation avant de compter dessus.
SKYREELS_API_KEY=


# ═══════════════════════════════════════════════════════════════════
#  Garde-fous de budget, en euros.
#  Même en cas de bug, tu ne peux pas dépasser ces montants.
# ═══════════════════════════════════════════════════════════════════
BUDGET_MENSUEL_EUR=80
BUDGET_MAX_PAR_VIDEO_EUR=0.60
BUDGET_MAX_PAR_ANALYSE_EUR=0.25

# ═══════════════════════════════════════════════════════════════════
#  Réglages
# ═══════════════════════════════════════════════════════════════════
# economique | equilibre | premium
PROFIL=equilibre
DUREE_CIBLE_S=45
LANGUE=fr
WEB_PORT=7777

# ═══════════════════════════════════════════════════════════════════
#  Chemins
# ═══════════════════════════════════════════════════════════════════
# Les vidéos de référence privées (`pdz references`, `pdz style`).
# Défaut : donnees/references/. Utile pour pointer vers un disque externe
# plutôt que de recopier des fichiers lourds dans le dépôt.
# Laissé COMMENTÉ exprès : une valeur vide n'est pas « pas de valeur ».
#PDZ_DOSSIER_REFERENCES=/mnt/disque/references
