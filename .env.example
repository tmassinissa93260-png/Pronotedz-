# --- Coeur de l'agent ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3000
DATABASE_PATH=./data.sqlite

# --- WhatsApp (Meta Cloud API) ---
# Necessite un compte Meta Business + un numero WhatsApp Business configure
# dans developers.facebook.com. phone_number_id est fourni par Meta.
WHATSAPP_VERIFY_TOKEN=choisis-un-secret-arbitraire
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Mapping phone_number_id (cote Meta) -> business_id (cote agent), format JSON.
WHATSAPP_BUSINESS_MAP={"REMPLACE_PAR_TON_PHONE_NUMBER_ID":"salon-belle-coupe"}

# --- Instagram / Messenger (Meta Messenger Platform) ---
# Necessite une Page Facebook liee a un compte Instagram professionnel.
MESSENGER_VERIFY_TOKEN=choisis-un-secret-arbitraire
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_API_VERSION=v21.0
# Mapping page_id -> business_id, format JSON.
MESSENGER_BUSINESS_MAP={"REMPLACE_PAR_TON_PAGE_ID":"fast-o-poulet"}

# --- Voix (Twilio) ---
# Necessite un compte Twilio + un numero vocal configure pour pointer vers
# /webhooks/voice/incoming (methode POST).
# Mapping numero Twilio (To, format E.164) -> business_id, format JSON.
VOICE_BUSINESS_MAP={"+213555000003":"chez-amina"}
