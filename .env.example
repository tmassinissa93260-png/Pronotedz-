VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Web Push — generate once with `npx web-push generate-vapid-keys`, this is
# the public half only (the private half is a Supabase Edge Function secret,
# never put it here). Push UI stays hidden until this is set.
VITE_VAPID_PUBLIC_KEY=
