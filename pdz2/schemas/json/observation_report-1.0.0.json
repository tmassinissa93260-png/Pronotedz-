{
  "$defs": {
    "ContractStatus": {
      "description": "Cycle de vie commun à tous les contrats.",
      "enum": [
        "draft",
        "validated",
        "rejected",
        "executed",
        "superseded",
        "failed"
      ],
      "title": "ContractStatus",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "description": "Une grandeur mesurée sur un artefact, avec sa méthode.",
      "properties": {
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "method"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "QaCheck": {
      "additionalProperties": false,
      "description": "Résultat d'une vérification déterministe.",
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "major"
        },
        "tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        }
      },
      "required": [
        "check_id",
        "name",
        "passed"
      ],
      "title": "QaCheck",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "minor",
        "major",
        "blocking"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "pdz2:observation_report/1.0.0",
  "additionalProperties": false,
  "description": "Mesures et vérifications sur un artefact rendu.",
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/QaCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "contract_type": {
      "title": "Contract Type",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "measurements": {
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "title": "Measurements",
      "type": "array"
    },
    "observer_version": {
      "minLength": 1,
      "title": "Observer Version",
      "type": "string"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "shot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shot Id"
    },
    "status": {
      "$ref": "#/$defs/ContractStatus",
      "default": "draft"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "contract_type",
    "version",
    "id",
    "created_at",
    "artifact_id",
    "observer_version",
    "checks",
    "passed"
  ],
  "title": "ObservationReport",
  "type": "object"
}
