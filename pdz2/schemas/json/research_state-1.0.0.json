        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "from_claim_id": {
          "minLength": 1,
          "title": "From Claim Id",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/CausalRelation",
          "default": "causes"
