# Copie ce fichier en .env et remplis avec les valeurs de ton projet Supabase
# (Project Settings > API dans le dashboard Supabase).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ne va JAMAIS dans ce fichier .env de l'app mobile : la clé Anthropic reste
# uniquement côté serveur, configurée via `supabase secrets set` pour les
# Edge Functions (voir README.md).
