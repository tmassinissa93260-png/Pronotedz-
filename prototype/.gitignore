# Jamais sur GitHub : cle API, session de navigateur
.env
browser_profile/

# Les resultats locaux restent locaux. Trois exceptions, que le workflow
# enregistre dans la branche : le storyboard, et les images produites.
app/output/*
!app/output/project.json
!app/output/shots/
!app/output/comparaison/

# Dans ces deux dossiers remontent les livrables — image, video, plan
# d'animation — mais pas les fichiers de travail : ni les prompts recopies,
# ni la voix, ni l'analyse brute.
app/output/shots/*
!app/output/shots/*/
app/output/shots/*/*
!app/output/shots/*/image.png
!app/output/shots/*/video.mp4
!app/output/shots/*/animation.json
app/output/comparaison/*
!app/output/comparaison/*.png
