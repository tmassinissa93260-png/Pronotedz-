# Jamais sur GitHub : la cle API
.env

# Les fichiers de travail restent locaux ; les livrables remontent.
app/output/*
!app/output/project.json
!app/output/elements.md
!app/output/timeline.json
!app/output/sous_titres.srt

# Les videos que TU deposes, et ce que le systeme en dit.
!app/output/videos/
!app/output/videos/*
!app/output/shots/
!app/output/shots/*/
app/output/shots/*/*
!app/output/shots/*/animation.json
!app/output/shots/*/video_analysis.json
# Un fichier par prompt : un lien par prompt, copiable depuis un telephone.
!app/output/shots/*/image_prompt.txt
!app/output/shots/*/animation_prompt.txt
!app/output/shots/*/voice.txt

# Le MP4 final et les rushes normalises ne sont pas versionnes.
app/output/final.mp4
app/output/montage/
