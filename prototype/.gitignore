# Jamais sur GitHub : cle API, session de navigateur
.env
browser_profile/

# Les resultats locaux restent locaux. Trois exceptions, que le workflow
# enregistre dans la branche : le storyboard, et les images produites.
app/output/*
!app/output/project.json
!app/output/shots/
!app/output/comparaison/

# Dans ces deux dossiers, seules les images remontent : ni les prompts
# intermediaires, ni les analyses, ni les videos.
app/output/shots/*
!app/output/shots/*/
app/output/shots/*/*
!app/output/shots/*/image.png
app/output/comparaison/*
!app/output/comparaison/*.png
