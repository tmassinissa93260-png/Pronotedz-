# Copie ce fichier en « .env » puis colle ta cle apres le signe =
# Ni espace, ni guillemets. .env ne doit jamais partir sur GitHub.

# UNE de ces deux lignes suffit.
#   OpenAI : payant, compte a creer sur platform.openai.com
#   Groq   : gratuit, meme protocole (api.groq.com/openai/v1)
OPENAI_API_KEY=
# GROQ_API_KEY=

# Avec Groq, l'analyse d'image et de video exige un modele qui sait LIRE une
# image. Nomme-le explicitement, sinon ces etapes echoueront.
# OPENAI_VISION_MODEL=

# Facultatif : le modele du cerveau, et le nombre d'allers-retours de correction.
# OPENAI_MODEL=gpt-4o
# MAX_REPAIR_ATTEMPTS=2

# Facultatif : ou tu deposes tes videos, ta voix off et ta musique.
# VIDEOS_DIR=
# VOICE_FILE=
# MUSIC_FILE=
