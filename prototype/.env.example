# Copie ce fichier en « .env » puis colle ta cle apres le signe =
# Ni espace, ni guillemets. Le fichier .env ne doit jamais partir sur GitHub.

OPENAI_API_KEY=

# Facultatif : modele utilise. gpt-4o gere le texte ET l'analyse d'image.
# OPENAI_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o

# Facultatif : navigateur invisible (machine sans ecran). Par defaut il est VISIBLE.
# HEADLESS=1

# Facultatif : delai max d'attente d'une generation Meta AI, en secondes.
# GENERATION_TIMEOUT_S=240
