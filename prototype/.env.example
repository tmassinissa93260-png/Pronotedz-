# Copie ce fichier en « .env » puis colle ta cle apres le signe =
# Ni espace, ni guillemets. Le fichier .env ne doit jamais partir sur GitHub.

# UNE de ces deux lignes suffit.
#   OpenAI : payant, compte a creer sur platform.openai.com
#   Groq   : gratuit, et parle le meme protocole (api.groq.com/openai/v1)
# Si OPENAI_API_KEY est vide et GROQ_API_KEY remplie, le programme bascule
# tout seul sur Groq.
OPENAI_API_KEY=
# GROQ_API_KEY=

# Avec Groq, l'analyse d'image exige un modele qui sait LIRE une image.
# Nomme-le explicitement, sinon l'etape 6 echouera :
# OPENAI_VISION_MODEL=

# Facultatif : modele utilise. gpt-4o gere le texte ET l'analyse d'image.
# OPENAI_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o

# Facultatif : navigateur invisible (machine sans ecran). Par defaut il est VISIBLE.
# HEADLESS=1

# Facultatif : delai max d'attente d'une generation Meta AI, en secondes.
# GENERATION_TIMEOUT_S=240

# Facultatif : utiliser TON navigateur plutot que le Chromium de Playwright.
# BROWSER_CHANNEL=chrome        # ou msedge
#
# Facultatif : reutiliser TON profil, donc TA connexion Meta deja faite.
# Chrome doit etre COMPLETEMENT ferme, sinon le profil est verrouille.
#   macOS   : BROWSER_PROFILE_DIR=/Users/TOI/Library/Application Support/Google/Chrome
#   Windows : BROWSER_PROFILE_DIR=C:\\Users\\TOI\\AppData\\Local\\Google\\Chrome\\User Data
#   Linux   : BROWSER_PROFILE_DIR=/home/TOI/.config/google-chrome

# Facultatif : fal.ai, pour la chaine 100% automatique (commande « produire »).
# Cle sur fal.ai/dashboard/keys. PAYANT, surtout la video.
# FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
